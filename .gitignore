# convenience for pushing the repo. It is deliberately NOT part
# of the repository — nobody ships a 39 MB binary in a template repo.
/gh.exe
gh_*.zip

# ── CLI smoke-test artifacts ────────────────────────────────
*.bak
out/
.smoke/
