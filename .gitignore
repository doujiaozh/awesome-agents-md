# ── Node / npm ──────────────────────────────────────────────
node_modules/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── OS / editor ─────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
